NODE_ENV=development
PORT=3000

# Local: Postgres do docker-compose. Produção (Neon): DATABASE_URL = string "pooled" (host com -pooler),
# DIRECT_URL = string direta. As strings do Neon já vêm com ?sslmode=require.
DATABASE_URL="postgresql://futebol:futebol@localhost:5435/futebol?schema=public"
DIRECT_URL="postgresql://futebol:futebol@localhost:5435/futebol?schema=public"

# Segredo para o hash dos tokens de sessão (mínimo 32 caracteres). Gere com: openssl rand -base64 32
SESSION_PEPPER="troque-por-um-segredo-com-32-ou-mais-caracteres"

# Origens liberadas no CORS, separadas por vírgula.
CORS_ORIGIN="http://localhost:5500"
